<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.tick.magna.MagnaApplication"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_magna_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_magna_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Magna">

        <!--
            Magna is a single-Activity app, so Firebase's automatic screen reporting would
            only ever report MainActivity. App.kt reports the real screen from the
            navigation back stack instead.
        -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <activity
            android:name="com.tick.magna.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
