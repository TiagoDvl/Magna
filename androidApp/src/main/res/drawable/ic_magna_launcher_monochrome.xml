<?xml version="1.0" encoding="utf-8"?>
<!--
    The same mark, flat, for Android 13's themed icons and for the notification tint.

    Identical geometry to ic_magna_launcher_foreground: the system supplies the colour from the
    wallpaper palette, so everything here is one stroke colour and the shapes have to hold up
    without any tonal separation between them. They do, because the bowl and the three arcs never
    touch — the innermost arc clears the bowl's rim by 5dp, and the arcs sit 3dp apart.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M43.29,50.11 A16,16 0 0 1 64.71,50.11" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M34.34,48.23 A24,24 0 0 1 73.66,48.23" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M25,48.48 A32,32 0 0 1 83,48.48" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M32,62 A22,20 0 0 0 76,62" />
</vector>
