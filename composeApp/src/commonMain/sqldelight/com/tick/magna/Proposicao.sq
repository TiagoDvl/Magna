CREATE TABLE Proposicao (
    id TEXT NOT NULL,
    legislaturaId TEXT NOT NULL,
    codTipo TEXT,
    ementa TEXT,
    dataApresentacao TEXT,
    autores TEXT,
    url TEXT,
    -- Added in 12.sqm. All nullable: a row stored before the API had classified the
    -- proposition keeps whatever it did have, and the card draws what is there.
    numero INTEGER,
    ano INTEGER,
    -- The first signature, by name, plus how many there are. /autores returns the name and
    -- the kind of author directly, and the kind matters: a third of the PLs in a measured
    -- window are signed by an orgao, not by a deputado.
    autorNome TEXT,
    autorTipo TEXT,
    autoresTotal INTEGER,
    situacao TEXT,
    orgaoSigla TEXT,
    -- Joined with TEMA_SEPARATOR. Two on the median, five at most, out of a vocabulary of 25.
    temas TEXT,
    PRIMARY KEY (id, legislaturaId),
    FOREIGN KEY(legislaturaId) REFERENCES Legislatura(id)
);

insertProposicao:
INSERT OR REPLACE INTO Proposicao VALUES ?;

-- Every type mixed, most recent first.
--
-- The Home used to ask for one type at a time, and that turned out to be the section's whole
-- problem: measured over the window it covers, PEC has 1 proposicao, MPV 24 and PLP 62, while
-- PL alone has 2074 and was not one of the three. Opening on PEC meant opening on a list of
-- one, and switching tabs meant re-entering loading to find out.
--
-- The limit is a parameter because five was written into this file, and a screen that wants
-- twenty should not need a second query to get it.
getProposicoes:
SELECT * FROM Proposicao
WHERE legislaturaId = :legislaturaId
ORDER BY dataApresentacao DESC LIMIT :limite;

-- One bucket of instruments rather than one sigla.
--
-- The filter is no longer PEC / MPV / PLP, which were three siglas out of the 544 the Camara
-- has and between them covered 87 of the 11333 propositions in a measured window. A bucket
-- takes the whole list its kind is made of, so `Lei` means PL, PLP, MPV, PLV, PLN and PLC at
-- once, and the four buckets together cover everything.
getProposicoesNosTipos:
SELECT * FROM Proposicao
WHERE legislaturaId = :legislaturaId AND codTipo IN :tipos
ORDER BY dataApresentacao DESC LIMIT :limite;

-- The complement, which is how Tramitacao is asked for.
--
-- It is the one bucket with no list of its own: it means every sigla the other three do not
-- claim, and those cannot be enumerated because the app will meet siglas written after this
-- file. `codTipo IS NULL` is included because a row stored before the sigla was resolved is
-- procedure as far as anyone can tell, and dropping it would lose it from every filter.
getProposicoesForaDosTipos:
SELECT * FROM Proposicao
WHERE legislaturaId = :legislaturaId AND (codTipo IS NULL OR codTipo NOT IN :tipos)
ORDER BY dataApresentacao DESC LIMIT :limite;
