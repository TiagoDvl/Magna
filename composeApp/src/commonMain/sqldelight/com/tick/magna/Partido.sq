-- Keyed by partido and legislatura together, for the same reason Deputado is: the same
-- twenty-seven parties exist across terms, so with id alone each one was a single row and
-- INSERT OR REPLACE handed it to whichever term synced last.
CREATE TABLE Partido (
    id TEXT NOT NULL,
    legislaturaId TEXT NOT NULL,
    liderDeputadoId TEXT,
    sigla TEXT NOT NULL,
    nome TEXT NOT NULL,
    situacao TEXT,
    totalPosse TEXT,
    totalMembros TEXT,
    logo TEXT,
    website TEXT,
    PRIMARY KEY (id, legislaturaId),
    FOREIGN KEY(legislaturaId) REFERENCES Legislatura(id)
);


insertPartido:
INSERT INTO Partido (
    id,
    legislaturaId,
    liderDeputadoId,
    sigla,
    nome,
    situacao,
    totalPosse,
    totalMembros,
    logo,
    website
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id, legislaturaId) DO UPDATE SET
    liderDeputadoId = COALESCE(excluded.liderDeputadoId, liderDeputadoId),
    sigla = excluded.sigla,
    nome = excluded.nome,
    situacao = COALESCE(excluded.situacao, situacao),
    totalPosse = COALESCE(excluded.totalPosse, totalPosse),
    totalMembros = COALESCE(excluded.totalMembros, totalMembros),
    logo = COALESCE(excluded.logo, logo),
    website = COALESCE(excluded.website, website);

getPartido:
SELECT * FROM Partido WHERE legislaturaId = :legislaturaId AND id = :partidoId;

-- Ordered here rather than in Kotlin, and for a reason: the two screens that show this list
-- both did `sortedByDescending { totalMembros }` over a column the sync never fills, so every
-- value was null, the sort changed nothing, and what was left was insertion order — which is
-- the order the API returns, which is alphabetical. The Home carousel then took the first
-- eight of that and showed AVANTE, CIDADANIA, DC where it meant to show the largest parties.
--
-- deputadoCount is counted from the Deputado table instead of read from a column, because no
-- endpoint gives a size that works for an older term: /partidos does not return one at all,
-- and /partidos/{id} answers 400 for any legislatura but the current one. Counting locally
-- costs no request and works everywhere. It counts everyone who held a seat for the party
-- during the term, suplentes included, so it runs a little above the bench of the day.
getPartidos:
SELECT
    Partido.*,
    (
        SELECT COUNT(*) FROM Deputado
        WHERE Deputado.legislaturaId = Partido.legislaturaId
          AND Deputado.partido = Partido.sigla
    ) AS deputadoCount,
    (PartidoFavorito.partidoId IS NOT NULL) AS isFavorito
FROM Partido
LEFT JOIN PartidoFavorito ON PartidoFavorito.partidoId = Partido.id
WHERE Partido.legislaturaId = :legislaturaId
ORDER BY isFavorito DESC, deputadoCount DESC, Partido.sigla ASC;
