-- Keyed by partido and legislatura together, for the same reason Deputado is: the same
-- twenty-seven parties exist across terms, so with id alone each one was a single row and
-- INSERT OR REPLACE handed it to whichever term synced last.
CREATE TABLE Partido (
    id TEXT NOT NULL,
    legislaturaId TEXT NOT NULL,
    liderDeputadoId TEXT,
    sigla TEXT NOT NULL,
    nome TEXT NOT NULL,
    situacao TEXT,
    totalPosse TEXT,
    totalMembros TEXT,
    logo TEXT,
    website TEXT,
    -- The party's own colour, as raw ARGB off its logo. Null where the register does not host
    -- one, which is twelve of the twenty-seven parties of the 57th.
    cor INTEGER,
    dataStatus TEXT,
    liderNome TEXT,
    liderUf TEXT,
    liderFoto TEXT,
    PRIMARY KEY (id, legislaturaId),
    FOREIGN KEY(legislaturaId) REFERENCES Legislatura(id)
);


insertPartido:
INSERT INTO Partido (
    id,
    legislaturaId,
    liderDeputadoId,
    sigla,
    nome,
    situacao,
    totalPosse,
    totalMembros,
    logo,
    website,
    cor,
    dataStatus,
    liderNome,
    liderUf,
    liderFoto
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
-- COALESCE throughout, so the cheap sync that knows only sigla and nome cannot wipe what the
-- enrichment pass filled in. The two run against the same rows and only one of them has the
-- detail endpoint's answer.
ON CONFLICT(id, legislaturaId) DO UPDATE SET
    liderDeputadoId = COALESCE(excluded.liderDeputadoId, liderDeputadoId),
    sigla = excluded.sigla,
    nome = excluded.nome,
    situacao = COALESCE(excluded.situacao, situacao),
    totalPosse = COALESCE(excluded.totalPosse, totalPosse),
    totalMembros = COALESCE(excluded.totalMembros, totalMembros),
    logo = COALESCE(excluded.logo, logo),
    website = COALESCE(excluded.website, website),
    cor = COALESCE(excluded.cor, cor),
    dataStatus = COALESCE(excluded.dataStatus, dataStatus),
    liderNome = COALESCE(excluded.liderNome, liderNome),
    liderUf = COALESCE(excluded.liderUf, liderUf),
    liderFoto = COALESCE(excluded.liderFoto, liderFoto);

getPartido:
SELECT * FROM Partido WHERE legislaturaId = :legislaturaId AND id = :partidoId;

-- Who still needs the detail endpoint and the logo read. The enrichment costs one request per
-- party plus one image, and it is worth exactly once per term: after it runs this answers
-- nothing and the sync does no work at all. `dataStatus` rather than `cor` is the marker,
-- because twelve parties legitimately end up with a null colour and would otherwise be asked
-- about on every launch forever.
getPartidosSemDetalhe:
SELECT id FROM Partido WHERE legislaturaId = :legislaturaId AND dataStatus IS NULL;

-- Ordered here rather than in Kotlin, and for a reason: the two screens that show this list
-- both did `sortedByDescending { totalMembros }` over a column the sync never fills, so every
-- value was null, the sort changed nothing, and what was left was insertion order — which is
-- the order the API returns, which is alphabetical. The Home carousel then took the first
-- eight of that and showed AVANTE, CIDADANIA, DC where it meant to show the largest parties.
--
-- deputadoCount is counted from the Deputado table instead of read from a column, because no
-- endpoint gives a size that works for an older term: /partidos does not return one at all,
-- and /partidos/{id} answers 400 for any legislatura but the current one. Counting locally
-- costs no request and works everywhere. It counts everyone who held a seat for the party
-- during the term, suplentes included, so it runs a little above the bench of the day.
getPartidos:
SELECT
    Partido.*,
    (
        SELECT COUNT(*) FROM Deputado
        WHERE Deputado.legislaturaId = Partido.legislaturaId
          AND Deputado.partido = Partido.sigla
    ) AS deputadoCount,
    -- The bench of the day, which is a different number from the one above: 648 people have
    -- held one of the 513 seats of the 57th, so counting everyone who passed through the term
    -- builds a house a fifth too big. Null `emExercicio` is excluded rather than assumed — a
    -- term synced before the column existed counts zero here, and the chart that reads it
    -- draws nothing rather than a wrong chamber.
    (
        SELECT COUNT(*) FROM Deputado
        WHERE Deputado.legislaturaId = Partido.legislaturaId
          AND Deputado.partido = Partido.sigla
          AND Deputado.emExercicio = 1
    ) AS bancadaCount,
    PartidoOrdem.posicao AS posicao
FROM Partido
LEFT JOIN PartidoOrdem ON PartidoOrdem.partidoId = Partido.id
WHERE Partido.legislaturaId = :legislaturaId
-- The chosen order first, then the rest by size. `posicao IS NULL` sorts 0 before 1, so a
-- party with a position comes before one without; SQLite would otherwise put every NULL first
-- and bury the whole point of the table.
ORDER BY (PartidoOrdem.posicao IS NULL) ASC, PartidoOrdem.posicao ASC,
         deputadoCount DESC, Partido.sigla ASC;
