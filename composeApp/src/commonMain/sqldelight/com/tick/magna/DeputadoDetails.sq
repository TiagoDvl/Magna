-- Keyed by deputado and legislatura together. The office, the phone and the website belong to
-- a mandate, not to a person, and with deputadoId alone the row followed the last term synced
-- exactly the way the Deputado row did.
CREATE TABLE DeputadoDetails(
    deputadoId TEXT NOT NULL,
    legislaturaId TEXT NOT NULL,
    gabineteBuilding TEXT,
    gabineteRoom TEXT,
    gabineteTelephone TEXT,
    gabineteEmail TEXT,
    urlWebsite TEXT,
    socials TEXT,
    PRIMARY KEY (deputadoId, legislaturaId),
    FOREIGN KEY(legislaturaId) REFERENCES Legislatura(id)
);

insertDeputadoDetails:
INSERT OR REPLACE INTO DeputadoDetails VALUES ?;

getDeputadoDetails:
SELECT * FROM DeputadoDetails WHERE deputadoId = :deputadoId AND legislaturaId = :legislaturaId;
