CREATE TABLE User (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    legislaturaId TEXT,
    FOREIGN KEY(legislaturaId) REFERENCES Legislatura(id)
);

-- Create
insertUser:
INSERT OR REPLACE INTO User VALUES ?;

getLastUser:
SELECT * FROM User ORDER BY id DESC LIMIT 1;

-- Update
-- Targets the same row getLastUser reads instead of hardcoding id 0. That only worked
-- because setupInitialUser inserts an explicit 0, and it would silently update nothing the
-- day that changed.
updateUserLegislatura:
UPDATE User SET legislaturaId = ?
WHERE id = (SELECT id FROM User ORDER BY id DESC LIMIT 1);